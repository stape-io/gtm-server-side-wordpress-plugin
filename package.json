{
  "name": "gtm-server-side-wordpress-plugin",
  "private": true,
  "description": "Build tooling for the plugin's inline browser scripts.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild .build/index.js --bundle --format=iife --target=es5 --minify --legal-comments=none --outfile=assets/js/service-worker-patch.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "env:e2e:start": "wp-env --config=.wp-env.e2e.json start",
    "env:e2e:stop": "wp-env --config=.wp-env.e2e.json stop",
    "env:e2e:destroy": "wp-env --config=.wp-env.e2e.json destroy",
    "env:e2e:logs": "wp-env --config=.wp-env.e2e.json logs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "lint:e2e": "eslint tests/e2e"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@playwright/test": "^1.63.0",
    "@testomatio/reporter": "^2.18.0",
    "@types/node": "^22.0.0",
    "@wordpress/e2e-test-utils-playwright": "^2.0.0",
    "@wordpress/env": "^11.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.0"
  }
}
